---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import TypeBadge from "../components/TypeBadge.astro";

const posts = (await getCollection("posts")).filter((p) => !p.data.draft);
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recent = posts.slice(0, 5);
const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "2-digit" });
const latest = posts[0]?.data.date;
---

<Base
  title="inference lab"
  description="A working log of serving LLMs on real hardware — measured from first principles."
>
  <!-- Hero: powered panel + HUD corner brackets. -->
  <section
    class="panel panel-signal"
    style="position:relative;margin-bottom:2.5rem"
  >
    <span class="hud-bracket tl"></span>
    <span class="hud-bracket br"></span>

    <span class="chip-signal" style="margin-bottom:1rem">
      <span class="led" style="color:hsl(var(--ok))"></span>status // live
    </span>

    <h1
      style="font-family:var(--font-sans);font-weight:700;font-size:2.75rem;line-height:1.05;letter-spacing:-0.03em;margin:0 0 1rem;color:hsl(var(--steel))"
    >
      inference lab
    </h1>

    <p
      style="color:hsl(var(--steel-2));font-size:0.9375rem;line-height:1.7;margin:0 0 1.75rem;max-width:66ch"
    >
      A working log of serving language models on real hardware. Rooflines by
      hand, throughput measured under steady-state load, and the failure modes
      that show up when the KV cache runs out. First principles, then numbers.
    </p>

    <!-- Truthful telemetry: nothing here is fabricated. -->
    <div style="max-width:34rem">
      <div class="data-row">
        <span class="k">build</span>
        <span class="v" style="color:hsl(var(--ok))">live</span>
      </div>
      <div class="data-row">
        <span class="k">rig</span>
        <span class="v">g5.2xlarge · A10G · 24GB</span>
      </div>
      <div class="data-row">
        <span class="k">control</span>
        <span class="v">Qwen3-8B</span>
      </div>
      <div class="data-row">
        <span class="k">reports</span>
        <span class="v">{String(posts.length).padStart(2, "0")}</span>
      </div>
      {
        latest && (
          <div class="data-row">
            <span class="k">last log</span>
            <span class="v">{fmtDate(latest)}</span>
          </div>
        )
      }
    </div>
  </section>

  <section>
    <div class="section-head">
      <span class="label-sys">▸ recent field reports</span>
      <a href="/posts/" class="section-action">all posts →</a>
    </div>

    <ol style="list-style:none;margin:0;padding:0;display:grid;gap:1rem">
      {
        recent.map((p) => (
          <li class="panel panel-interactive">
            <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;margin-bottom:0.625rem">
              <span class="data" style="color:hsl(var(--steel-muted))">
                {fmtDate(p.data.date)}
              </span>
              <TypeBadge type={p.data.type} />
            </div>
            <h3 style="font-family:var(--font-sans);font-weight:600;font-size:1.1875rem;margin:0 0 0.5rem;line-height:1.25">
              <a href={`/posts/${p.id}/`} class="link">
                {p.data.title}
              </a>
            </h3>
            <p style="color:hsl(var(--steel-2));font-size:0.9375rem;line-height:1.6;margin:0;max-width:72ch">
              {p.data.summary}
            </p>
          </li>
        ))
      }
    </ol>

    <div style="margin-top:1.5rem">
      <a href="/posts/" class="btn btn-primary">all posts</a>
    </div>
  </section>
</Base>
