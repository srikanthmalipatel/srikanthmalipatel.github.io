---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import TypeBadge from "../components/TypeBadge.astro";

const posts = (await getCollection("posts")).filter((p) => !p.data.draft);
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recent = posts.slice(0, 5);
const fmtDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "2-digit" });
---

<Base
  title="inference lab"
  description="Notes and experiments on inference engineering, language model serving, and GPU performance."
>
  <section style="margin-bottom:3rem">
    <h1
      style="font-family:var(--font-sans);font-weight:700;font-size:2.75rem;line-height:1.05;letter-spacing:-0.03em;margin:0 0 1rem;color:hsl(var(--steel))"
    >
      inference lab
    </h1>

    <p
      style="color:hsl(var(--steel-2));font-size:0.9375rem;line-height:1.7;margin:0;max-width:66ch"
    >
      Notes and experiments on inference engineering. I explore how language
      models run on GPUs and what affects their performance.
    </p>
  </section>

  <section>
    <div class="section-head">
      <span class="label-sys">Recent posts</span>
      <a href="/posts/" class="section-action">all posts →</a>
    </div>

    <ol style="list-style:none;margin:0;padding:0;display:grid;gap:1rem">
      {
        recent.map((p) => (
          <li class="panel panel-interactive">
            <div style="display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;margin-bottom:0.625rem">
              <span class="data" style="color:hsl(var(--steel-muted))">
                {fmtDate(p.data.date)}
              </span>
              <TypeBadge type={p.data.type} />
            </div>
            <h3 style="font-family:var(--font-sans);font-weight:600;font-size:1.1875rem;margin:0 0 0.5rem;line-height:1.25">
              <a href={`/posts/${p.id}/`} class="link">
                {p.data.title}
              </a>
            </h3>
            <p style="color:hsl(var(--steel-2));font-size:0.9375rem;line-height:1.6;margin:0;max-width:72ch">
              {p.data.summary}
            </p>
          </li>
        ))
      }
    </ol>

  </section>
</Base>
