---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("posts")).filter((p) => !p.data.draft);
posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmtDate = (date: Date) => date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "2-digit",
  timeZone: "UTC",
});
---

<Base title="Posts // inference lab" description="Notes and experiments on inference engineering.">
  <h1 class="page-title">Posts</h1>

  <div class="post-search">
    <label for="post-search" class="label-sys">Search posts</label>
    <input
      id="post-search"
      class="input"
      type="search"
      placeholder="Search by title or topic"
      aria-controls="post-list"
    />
  </div>

  <ol id="post-list" class="post-archive">
    {posts.map((post) => (
      <li
        class="archive-entry"
        data-search={[post.data.title, post.data.summary, ...post.data.topics, ...post.data.tags].join(" ").toLowerCase()}
      >
        <time datetime={post.data.date.toISOString().slice(0, 10)} class="data">
          {fmtDate(post.data.date)}
        </time>
        <h2><a href={`/posts/${post.id}/`} class="link">{post.data.title}</a></h2>
        <p>{post.data.summary}</p>
        <div class="post-tags">
          {post.data.tags.map((tag) => (
            <a href={`/posts/?q=${encodeURIComponent(tag)}`} class="tag-link">#{tag}</a>
          ))}
        </div>
      </li>
    ))}
  </ol>
  <p id="no-match" class="search-empty" role="status" hidden>No posts match your search.</p>

  <script>
    const search = document.querySelector<HTMLInputElement>("#post-search")!;
    const entries = [...document.querySelectorAll<HTMLElement>(".archive-entry")];
    const noMatch = document.querySelector<HTMLElement>("#no-match")!;
    function filterPosts() {
      const query = search.value.trim().toLowerCase();
      let matches = 0;
      for (const entry of entries) {
        entry.hidden = !entry.dataset.search!.includes(query);
        if (!entry.hidden) matches++;
      }
      noMatch.hidden = matches !== 0;
    }
    search.value = new URLSearchParams(window.location.search).get("q") ?? "";
    search.addEventListener("input", filterPosts);
    filterPosts();
  </script>
</Base>
